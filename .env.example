# Local development only. Copy to .env and choose a password before starting Docker.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentgate
POSTGRES_USER=agentgate
POSTGRES_PASSWORD=

BACKEND_URL=http://localhost:5000
# Browser requests use the Vite proxy; never put secrets in VITE_ variables.
VITE_API_BASE_URL=/api

# Generate a random signing secret (minimum 32 bytes). Never use this in VITE_ variables.
JWT_SECRET=
JWT_ISSUER=AgentGate
JWT_AUDIENCE=AgentGate.Dashboard

# No-match decisions: only Review or Deny are accepted. Explicit policies can allow.
PolicyDefaults__Development=Review
PolicyDefaults__Staging=Deny
PolicyDefaults__Production=Deny
Approvals__TimeoutMinutes=1440

# Reserved for later phases; unused by Phase 1.
LLM_PROVIDER=groq
LLM_API_KEY=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
